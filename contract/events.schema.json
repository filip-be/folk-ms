{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folk-ms/contract/events.schema.json",
  "title": "folk-ms Site snapshot",
  "description": "All Events of one Organization that its Site shows (not Hidden, not in the Bin), as read by its Site from pub/sites/<site>/events.json. Values are effective: a Moderator's Override, else Facebook's. Localized texts: Polish (pl) is always present; English (en) is optional and readers fall back to Polish when it is absent.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "organization",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "organization": {
      "$ref": "#/$defs/organization"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": [
        "pl"
      ],
      "additionalProperties": false,
      "properties": {
        "pl": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "organization": {
      "type": "object",
      "required": [
        "id",
        "name",
        "siteId",
        "baseUrl",
        "timezone"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "siteId": {
          "$ref": "#/$defs/id"
        },
        "baseUrl": {
          "$ref": "#/$defs/url"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "description": "Free-text price and/or a tickets link; at least one is present.",
      "properties": {
        "text": {
          "$ref": "#/$defs/localizedText"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "alt": {
          "$ref": "#/$defs/localizedText"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "width",
              "height",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        }
      }
    },
    "occurrence": {
      "type": "object",
      "required": [
        "start",
        "end",
        "cancelled",
        "facebookEventUrl"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "cancelled": {
          "type": "boolean"
        },
        "online": {
          "type": "boolean",
          "enum": [
            true
          ],
          "description": "An online event; present only when true"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "facebookEventUrl": {
          "type": "string",
          "pattern": "^https://www\\.facebook\\.com/events/[0-9]+/$",
          "maxLength": 100,
          "description": "The Facebook Event page of this Occurrence"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "shortId",
        "slug",
        "permalink",
        "title",
        "occurrences",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]{8,32}$"
        },
        "shortId": {
          "type": "string",
          "pattern": "^[a-z2-7]{8}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "permalink": {
          "type": "object",
          "required": [
            "pl",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "pl": {
              "$ref": "#/$defs/url"
            },
            "en": {
              "$ref": "#/$defs/url"
            }
          }
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "summary": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "price": {
          "$ref": "#/$defs/price"
        },
        "cover": {
          "$ref": "#/$defs/image"
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/occurrence"
          },
          "description": "Sorted by start"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Where an Occurrence happens: free text from Facebook or the Moderator.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "mapUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048,
      "description": "Links shown to visitors: https only"
    }
  }
}
