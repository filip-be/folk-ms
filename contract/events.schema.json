{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folk-ms/contract/events.schema.json",
  "title": "folk-ms Site snapshot",
  "description": "All Published Events of one Organization, as read by its Site from pub/sites/<site>/events.json. Localized texts: Polish (pl) is always present; English (en) is optional and readers fall back to Polish when it is absent.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "organization", "venues", "events"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "organization": { "$ref": "#/$defs/organization" },
    "venues": {
      "description": "Venues referenced by Occurrences, keyed by venue id. A frozen copy of a Venue as it was for past Occurrences has its own key.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/venue" }
    },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["pl"],
      "additionalProperties": false,
      "properties": {
        "pl": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 },
    "organization": {
      "type": "object",
      "required": ["id", "name", "siteId", "baseUrl", "timezone"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/localizedText" },
        "siteId": { "$ref": "#/$defs/id" },
        "baseUrl": { "$ref": "#/$defs/url" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "venue": {
      "type": "object",
      "required": ["name", "address"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "address": { "type": "string", "minLength": 1, "maxLength": 500 },
        "mapUrl": { "$ref": "#/$defs/url" }
      }
    },
    "price": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/localizedText" },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "image": {
      "type": "object",
      "required": ["variants"],
      "additionalProperties": false,
      "properties": {
        "alt": { "$ref": "#/$defs/localizedText" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["width", "height", "url"],
            "additionalProperties": false,
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "url": { "$ref": "#/$defs/url" }
            }
          }
        }
      }
    },
    "recurrence": {
      "type": "object",
      "required": ["freq", "weekday", "startDate", "endDate"],
      "additionalProperties": false,
      "properties": {
        "freq": { "type": "string", "enum": ["weekly", "biweekly", "monthly"] },
        "weekday": { "type": "integer", "minimum": 0, "maximum": 6, "description": "0 = Sunday" },
        "nth": { "type": "integer", "enum": [-1, 1, 2, 3, 4], "description": "Monthly only: Nth weekday of the month, -1 = last" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" }
      }
    },
    "occurrence": {
      "type": "object",
      "required": ["start", "end", "cancelled", "venueId"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "cancelled": { "type": "boolean" },
        "venueId": { "type": "string", "minLength": 1 },
        "note": { "$ref": "#/$defs/localizedText" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "shortId", "slug", "permalink", "kind", "title", "occurrences", "publishedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]{8,32}$" },
        "shortId": { "type": "string", "pattern": "^[a-z2-7]{8}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
        "permalink": {
          "type": "object",
          "required": ["pl", "en"],
          "additionalProperties": false,
          "properties": {
            "pl": { "$ref": "#/$defs/url" },
            "en": { "$ref": "#/$defs/url" }
          }
        },
        "kind": { "type": "string", "enum": ["single", "multiDay", "recurring"] },
        "title": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "price": { "$ref": "#/$defs/price" },
        "cover": { "$ref": "#/$defs/image" },
        "recurrence": { "$ref": "#/$defs/recurrence" },
        "occurrences": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/occurrence" } },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
